{
  "name": "price-tracker",
  "productName": "Price Tracker",
  "version": "2.7.2",
  "description": "Live prices, charts and price-action analysis for VCG Markets",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-packager . \"Price Tracker\" --platform=darwin --arch=arm64,x64 --icon=build/icon.icns --out=dist --overwrite --app-bundle-id=local.pricetracker.app --ignore=\"^/(dist|build|tools|tests|node_modules|android|www|scripts|\\.github|capacitor\\.config\\.json|README\\.md|\\.gitignore|package-lock\\.json)\"",
    "build:win": "electron-packager . \"Price Tracker\" --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"^/(dist|build|tools|tests|node_modules|android|www|scripts|\\.github|capacitor\\.config\\.json|README\\.md|\\.gitignore|package-lock\\.json)\"",
    "build:www": "node scripts/build-www.js",
    "android:sync": "node scripts/build-www.js && npx cap sync android",
    "test": "node --test tests/unit/*.test.js",
    "test:ui": "npm run build:www && electron --no-sandbox tests/ui/run.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@electron/packager": "^20.3.0",
    "electron": "^39.8.10"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  }
}
