{
  "name": "price-tracker",
  "productName": "Price Tracker",
  "version": "2.0.3",
  "description": "Live prices, charts and price-action analysis for VCG Markets",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-packager . \"Price Tracker\" --platform=darwin --arch=arm64,x64 --icon=build/icon.icns --out=dist --overwrite --app-bundle-id=local.pricetracker.app --ignore=\"^/(dist|build|tools|node_modules|README\\.md|\\.gitignore|package-lock\\.json)\"",
    "build:win": "electron-packager . \"Price Tracker\" --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"^/(dist|build|tools|node_modules|README\\.md|\\.gitignore|package-lock\\.json)\""
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^39.8.10"
  }
}