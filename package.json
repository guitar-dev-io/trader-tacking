{
  "name": "price-tracker",
  "productName": "Price Tracker",
  "version": "2.9.1",
  "description": "Live prices, charts and price-action analysis for VCG Markets",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-packager . \"Price Tracker\" --platform=darwin --arch=arm64,x64 --icon=build/icon.icns --out=dist --overwrite --app-bundle-id=local.pricetracker.app --ignore=\"^/(dist|dist-win|build|tools|tests|node_modules|android|www|scripts|\\.github|capacitor\\.config\\.json|README\\.md|\\.gitignore|package-lock\\.json)\"",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:www": "node scripts/build-www.js",
    "android:sync": "node scripts/build-www.js && npx cap sync android",
    "test": "node --test tests/unit/*.test.js",
    "test:ui": "npm run build:www && electron --no-sandbox tests/ui/run.js"
  },
  "author": "Price Tracker",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@electron/packager": "^20.3.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  },
  "build": {
    "appId": "local.pricetracker.app",
    "productName": "Price Tracker",
    "directories": {
      "output": "dist-win",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!{dist,dist-win,tools,tests,android,www,scripts,out,.github}/**",
      "!capacitor.config.json",
      "!README.md",
      "!build/icon.icns",
      "!**/*.map"
    ],
    "asar": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Price Tracker",
      "artifactName": "Price-Tracker-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Price-Tracker-portable-${version}.${ext}"
    },
    "artifactName": "Price-Tracker-${version}-win-${arch}.${ext}"
  }
}
