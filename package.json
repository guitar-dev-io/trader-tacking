{
  "name": "price-tracker",
  "productName": "Price Tracker",
  "version": "2.16.0",
  "description": "Live prices, charts and price-action analysis for VCG Markets",
  "main": "gen/main/main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-packager . \"Price Tracker\" --platform=darwin --arch=arm64,x64 --icon=build/icon.icns --out=dist --overwrite --app-bundle-id=local.pricetracker.app --ignore=\"^/(dist|dist-win|build|tools|tests|node_modules|android|www|scripts|src|vite|site|claude|_site|docs|\\.github|capacitor\\.config\\.json|vite\\.config\\.mjs|svelte\\.config\\.mjs|tsconfig[^/]*\\.json|README\\.md|\\.gitignore|package-lock\\.json)(/|$)\"",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:www": "node scripts/build-www.js",
    "android:sync": "node scripts/build-www.js && npx cap sync android",
    "test": "node --test tests/unit/*.test.js",
    "test:ui": "npm run build:renderer && npm run build:www && electron --no-sandbox tests/ui/run.js",
    "build:renderer": "vite build --mode desktop --logLevel warn",
    "dev": "node scripts/dev.js",
    "prestart": "npm run build:core && npm run build:renderer",
    "prebuild:mac": "npm run build:renderer",
    "prebuild:win": "npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --output human",
    "build:core": "node scripts/build-core.mjs",
    "pretest": "npm run build:core"
  },
  "author": "Price Tracker",
  "license": "MIT",
  "devDependencies": {
    "@babel/parser": "^8.1.3",
    "@babel/traverse": "^8.1.3",
    "@capacitor/cli": "^8.6.2",
    "@electron/packager": "^20.3.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.20.7",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "lightweight-charts": "5.3.0",
    "lucide-static": "^1.81.0",
    "magic-string": "^1.4.5",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  },
  "build": {
    "appId": "local.pricetracker.app",
    "productName": "Price Tracker",
    "directories": {
      "output": "dist-win",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!{dist,dist-win,tools,tests,android,www,scripts,out,.github,src,vite,site,_site,docs,claude}/**",
      "!capacitor.config.json",
      "!README.md",
      "!build/icon.icns",
      "!**/*.map",
      "!vite.config.mjs",
      "!tsconfig*.json",
      "!svelte.config.mjs",
      "!gen/**/*.d.ts"
    ],
    "asar": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Price Tracker",
      "artifactName": "Price-Tracker-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Price-Tracker-portable-${version}.${ext}"
    },
    "artifactName": "Price-Tracker-${version}-win-${arch}.${ext}"
  }
}
